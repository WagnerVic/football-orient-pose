FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget unzip libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# MMPose stack via OpenMIM (resolves mmcv/CUDA compatibility automatically)
RUN pip install --no-cache-dir openmim && \
    mim install --no-cache-dir "mmengine>=0.10.0" "mmcv>=2.1.0" "mmpose>=1.3.0"

# Project deps
WORKDIR /workspace
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e "." --no-deps && \
    pip install --no-cache-dir numpy opencv-python scipy matplotlib tqdm

# Pesos COCO para Transfer Learning (Cenários C/D) — baked na imagem
# Baixa uma vez no build; não precisa de nada no host.
RUN mkdir -p /workspace/checkpoints && \
    wget -q --show-progress -L \
    "https://download.openmmlab.com/mmpose/v1/body_2d_keypoint/rtmpose/body7/rtmpose-x_simcc-body7_pt-body7_700e-384x288-71d7b7e9_20230629.pth" \
    -O /workspace/checkpoints/rtmpose-x_coco.pth

COPY . .

ENV PYTHONPATH=/workspace/src:$PYTHONPATH
